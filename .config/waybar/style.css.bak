* {
    border: none;
    border-radius: 12px;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 14px;
    min-height: 0;
}

window#waybar {
    background: rgba(30, 30, 46, 0.7);
    color: #CDD6F4;
}

#workspaces {
    margin: 6px;
}

#workspaces button {
    padding: 0 10px;
    margin: 4px;
    border-radius: 10px;
    background: transparent;
    color: #CDD6F4;
    transition: all 0.3s ease;
}

#workspaces button.active {
    background: #CBA6F7;
    color: #1E1E2E;
}

#workspaces button:hover {
    background: #585B70;
}

#clock,
#battery,
#network,
#pulseaudio {
    margin: 6px;
    padding: 0 14px;
    background: rgba(49, 50, 68, 0.85);
    border-radius: 10px;
}
