/* Waybar — "Mocha Neon" islands (CSS only; config untouched) */
* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    font-weight: 600;
    min-height: 0;
}
window#waybar {
    background: transparent;
    color: #cdd6f4;
}
tooltip {
    background: #1e1e2e;
    border: 2px solid #cba6f7;
    border-radius: 12px;
}
tooltip label { color: #cdd6f4; }

#workspaces {
    background: rgba(30, 30, 46, 0.85);
    border-radius: 14px;
    margin: 4px 6px;
    padding: 0 4px;
}
#workspaces button {
    color: #6c7086;
    padding: 0 8px;
    margin: 3px 2px;
    border-radius: 9px;
    transition: all 0.25s cubic-bezier(0.25, 0.1, 0.25, 1);
}
#workspaces button.active {
    color: #11111b;
    background: linear-gradient(135deg, #cba6f7, #89dceb);
    box-shadow: 0 0 10px rgba(203, 166, 247, 0.6);
    padding: 0 14px;
}
#workspaces button:hover {
    color: #cdd6f4;
    background: rgba(203, 166, 247, 0.25);
}

#window { color: #a6adc8; font-weight: 500; }

#mpd, #custom-media, #idle_inhibitor, #pulseaudio, #network,
#power-profiles-daemon, #cpu, #memory, #temperature, #backlight,
#keyboard-state, #language, #battery, #clock, #tray, #custom-power {
    background: rgba(30, 30, 46, 0.85);
    padding: 0 11px;
    margin: 4px 3px;
    border-radius: 12px;
    transition: all 0.2s ease;
}

#clock        { color: #f9e2af; font-weight: 700; }
#cpu          { color: #fab387; }
#memory       { color: #94e2d5; }
#temperature  { color: #f38ba8; }
#temperature.critical { color: #11111b; background: #f38ba8; }
#network      { color: #89dceb; }
#pulseaudio   { color: #f5c2e7; }
#backlight    { color: #f9e2af; }
#battery      { color: #a6e3a1; }
#battery.warning  { color: #fab387; }
#battery.critical { color: #f38ba8; }
#idle_inhibitor   { color: #cba6f7; }
#idle_inhibitor.activated { color: #a6e3a1; }
#power-profiles-daemon { color: #fab387; }
#keyboard-state { color: #cba6f7; }
#language       { color: #89dceb; }
#mpd            { color: #a6e3a1; }
#custom-media   { color: #f5c2e7; }
#custom-power   { color: #f38ba8; background: rgba(243, 139, 168, 0.15); }
#custom-power:hover { background: #f38ba8; color: #11111b; }
#tray menu { background: #1e1e2e; }
